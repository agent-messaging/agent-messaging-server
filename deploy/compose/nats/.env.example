# Copy to .env beside compose.yaml and change what you need. Every value here
# is the default.

# The host address every port is published on.
BIND_ADDRESS=127.0.0.1

# The host ports.
SERVER_PORT=3005
NATS_PORT=4222
NATS_WS_PORT=4443
GATEWAY_PORT=8090

# Read by first-run on the first start only.
MESH_NAME=agent-messaging
# MESH_NATS_ENDPOINTS=nats://mesh.example.com:4222,wss://mesh.example.com:4443
# MESH_PUBLIC_URL=https://mesh.example.com

# The A2A gateway.
# GATEWAY_PUBLIC_URL=https://a2a.example.com
# GATEWAY_API_KEYS=

# Released images instead of a build from this clone.
# SERVER_IMAGE=ghcr.io/jeffrschneider/agent-messaging-server:0.1.3
# GATEWAY_IMAGE=ghcr.io/jeffrschneider/agent-messaging-a2a-gateway:0.1.3
