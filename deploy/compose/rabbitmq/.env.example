# Copy to .env beside compose.yaml and change what you need. Every value here
# is the default.

# The host address every port is published on.
BIND_ADDRESS=127.0.0.1

# The host ports.
SERVER_PORT=3005
AMQP_PORT=5672
GATEWAY_PORT=8090

# Read by first-run on the first start only.
MESH_NAME=agent-messaging
# MESH_AMQP_ENDPOINTS=amqps://mesh.example.com:5671/mesh
# MESH_PUBLIC_URL=https://mesh.example.com

# A Postgres you already run (with compose.own-postgres.yaml; see README.md).
# MESH_POSTGRES_URL=postgres://mesh@db.example.com:5432/mesh
# MESH_POSTGRES_PASSWORD_HOST_FILE=./postgres.password

# The A2A gateway.
# GATEWAY_PUBLIC_URL=https://a2a.example.com
# GATEWAY_API_KEYS=

# The images. compose.yaml pins the latest release, these two; set another
# version here to run it. To upgrade: docker compose pull && docker compose up -d
# SERVER_IMAGE=ghcr.io/agent-messaging/agent-messaging-server:0.4.2
# GATEWAY_IMAGE=ghcr.io/agent-messaging/agent-messaging-a2a-gateway:0.4.2
