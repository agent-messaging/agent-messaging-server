    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "amqplib": "^2.2.0",
    "better-sqlite3": "^12.11.1",
    "jose": "^6.2.12",
    "nats": "^2.28.2",
    "nats-jwt": "^0.0.9",
    "nkeys.js": "^1.1.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
