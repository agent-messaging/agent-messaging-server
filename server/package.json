{
  "name": "agent-messaging-server",
  "version": "0.4.7",
  "description": "The Agent Messaging Server: the core profile of Agent Messaging, on NATS JetStream or on RabbitMQ with Postgres.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server-main.ts",
    "first-run": "tsx src/setup/first-run.ts",
