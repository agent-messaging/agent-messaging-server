  "knock": {
    "comment": "EXT-14 §9. A knock's metadata carries only via (at most 80 characters) and grants; anything else is refused with KNOCK_CARRIES_NO_MESSAGE and nothing is sent. A queued acknowledgement that says neither delivered nor paused means the door has not let the caller in, whoever signed it: auth-required, the same answer for held, blocked and absent, never rejected.",
    "inputs": [
      {
        "name": "an empty knock",
        "knock": {},
        "expect": {
          "input": {
            "grants": []
          }
        }
      },
      {
        "name": "a label and grants",
        "knock": {
          "via": "Quote desk at example.com",
          "grants": [
            "read"
          ]
        },
        "expect": {
          "input": {
            "via": "Quote desk at example.com",
            "grants": [
              "read"
            ]
          }
        }
      },
      {
        "name": "words are refused",
        "knock": {
          "text": "Let me in, I have an offer"
        },
        "expect": {
          "refused": "KNOCK_CARRIES_NO_MESSAGE"
        }
      },
      {
        "name": "a label over 80 characters is refused",
        "knock": {
          "via": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        },
        "expect": {
          "refused": "KNOCK_CARRIES_NO_MESSAGE"
        }
      },
      {
        "name": "grants that are not names are refused",
        "knock": {
          "grants": [
            1
          ]
        },
        "expect": {
          "refused": "KNOCK_CARRIES_NO_MESSAGE"
        }
      }
    ],
