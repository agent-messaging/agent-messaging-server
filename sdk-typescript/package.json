{
  "name": "agent-messaging",
  "version": "0.62.2",
  "description": "TypeScript SDK for Agent Messaging: signed, store-and-forward messaging between agents, over NATS or AMQP",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "nats.ws": "^1.29.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "nkeys.js": "^1.1.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "agent",
    "agent-messaging",
    "a2a",
    "nats",
    "amqp",
    "rabbitmq",
    "multi-agent",
    "agent-to-agent"
  ]
}
